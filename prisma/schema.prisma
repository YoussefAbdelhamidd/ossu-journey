generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

/// Single learner plus a tutor who reviews understanding-check answers.
model User {
  id              String            @id @default(cuid())
  email           String            @unique
  name            String
  passwordHash    String
  role            String
  timezone        String            @default("Africa/Cairo")
  createdAt       DateTime          @default(now())
  answers         Answer[]
  progress        Progress[]
  studyDays       StudyDay[]
  feedback        Feedback[]        @relation("TutorFeedback")
  notes           LectureNote[]
  playbacks       Playback[]
  libraryGroups   LibraryGroup[]
  contentMix      UserContentMix[]
  episodeNotes    EpisodeNote[]
  episodePlaybacks EpisodePlayback[]
}

model Section {
  id          String       @id
  title       String
  summary     String
  order       Int
  coverImage  String?
  subsections Subsection[]
}

model Subsection {
  id        String    @id
  sectionId String
  section   Section   @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  title     String
  summary   String
  topics    String
  order     Int
  courses   Course[]

  @@index([sectionId])
}

model Course {
  id                  String       @id
  subsectionId        String
  subsection          Subsection   @relation(fields: [subsectionId], references: [id], onDelete: Cascade)
  title               String
  provider            String?
  instructor          String?
  url                 String
  altUrl              String?
  guideUrl            String?
  discussionUrl       String?
  playlistUrl         String?
  durationWeeks       Float?
  durationLabel       String?
  hoursPerWeekMin     Float?
  hoursPerWeekMax     Float?
  estimatedHours      Float?
  prerequisites       String
  notes               String?
  required            Boolean      @default(true)
  choiceGroup         String?
  videoTodo           String?
  coverImage          String?
  offersCertificate   Boolean      @default(false)
  certificateLabel    String?
  order               Int
  lectures            Lecture[]
  assignments         Assignment[]
  readings            Reading[]

  @@index([subsectionId])
}

model Lecture {
  id              String         @id
  courseId        String
  course          Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  number          Int
  title           String
  summary         String
  readings        String?
  youtubeId       String?
  videoTodo       String?
  durationSeconds Int?
  pageUrl         String?
  slidesUrl       String?
  codeUrl         String?
  order           Int
  questions       Question[]
  notes           LectureNote[]
  playbacks       Playback[]

  @@unique([courseId, number])
  @@index([courseId])
}

model Assignment {
  id                      String  @id
  courseId                String
  course                  Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  kind                    String
  code                    String
  title                   String
  summary                 String
  url                     String?
  codeUrl                 String?
  solutionsUrl            String?
  lectureNumber           Int?
  dueBeforeLectureNumber  Int?
  releasedAtLectureNumber Int?
  graded                  Boolean @default(true)
  order                   Int

  @@index([courseId])
}

model Reading {
  id       String  @id
  courseId String
  course   Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title    String
  author   String?
  kind     String
  url      String
  summary  String?
  order    Int

  @@index([courseId])
}

model Question {
  id        String   @id
  lectureId String
  lecture   Lecture  @relation(fields: [lectureId], references: [id], onDelete: Cascade)
  order     Int
  kind      String
  prompt    String
  answers   Answer[]

  @@unique([lectureId, order])
}

model Answer {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  questionId String
  question   Question  @relation(fields: [questionId], references: [id], onDelete: Cascade)
  body       String
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  feedback   Feedback?

  @@unique([userId, questionId])
}

model Feedback {
  id        String   @id @default(cuid())
  answerId  String   @unique
  answer    Answer   @relation(fields: [answerId], references: [id], onDelete: Cascade)
  tutorId   String
  tutor     User     @relation("TutorFeedback", fields: [tutorId], references: [id], onDelete: Cascade)
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Progress {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  targetType String
  targetId   String
  status     String
  manual     Boolean  @default(false)
  updatedAt  DateTime @updatedAt

  @@unique([userId, targetType, targetId])
  @@index([userId])
}

model LectureNote {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lectureId String
  lecture   Lecture  @relation(fields: [lectureId], references: [id], onDelete: Cascade)
  body      String   @default("")
  updatedAt DateTime @updatedAt

  @@unique([userId, lectureId])
  @@index([userId])
}

model Playback {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lectureId       String
  lecture         Lecture  @relation(fields: [lectureId], references: [id], onDelete: Cascade)
  positionSeconds Int      @default(0)
  updatedAt       DateTime @updatedAt

  @@unique([userId, lectureId])
  @@index([userId])
}

model StudyDay {
  id       String  @id @default(cuid())
  userId   String
  user     User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  date     String
  inWindow Boolean @default(false)

  @@unique([userId, date])
}

/// Personal library group owned by one learner (English, German, religion, etc.).
model LibraryGroup {
  id          String           @id @default(cuid())
  ownerId     String
  owner       User             @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  category    String
  title       String
  coverImage  String?
  isCourse    Boolean          @default(false)
  playlistUrl String?
  startedAt   DateTime?
  shareToken  String?          @unique
  order       Int              @default(0)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  episodes    LibraryEpisode[]
  goals       LibraryGoal[]

  @@index([ownerId])
  @@index([category])
}

model LibraryEpisode {
  id              String            @id @default(cuid())
  groupId         String
  group           LibraryGroup      @relation(fields: [groupId], references: [id], onDelete: Cascade)
  number          Int
  title           String
  summary         String?
  youtubeId       String?
  /// Official / public-domain watch page (BBC, DW, Archive, ARD…). Never sketchy streamers.
  externalUrl     String?
  durationSeconds Int?
  order           Int
  notes           EpisodeNote[]
  playbacks       EpisodePlayback[]

  @@unique([groupId, number])
  @@index([groupId])
}

model LibraryGoal {
  id      String       @id @default(cuid())
  groupId String
  group   LibraryGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  body    String
  order   Int

  @@index([groupId])
}

model UserContentMix {
  id       String @id @default(cuid())
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  category String
  percent  Int

  @@unique([userId, category])
  @@index([userId])
}

model EpisodeNote {
  id        String         @id @default(cuid())
  userId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  episodeId String
  episode   LibraryEpisode @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  body      String         @default("")
  updatedAt DateTime       @updatedAt

  @@unique([userId, episodeId])
  @@index([userId])
}

model EpisodePlayback {
  id              String         @id @default(cuid())
  userId          String
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  episodeId       String
  episode         LibraryEpisode @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  positionSeconds Int            @default(0)
  updatedAt       DateTime       @updatedAt

  @@unique([userId, episodeId])
  @@index([userId])
}
