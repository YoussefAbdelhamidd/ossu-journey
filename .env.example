# Neon (production). Copy both strings from the Neon dashboard.
# DATABASE_URL is the pooled host (the hostname contains "-pooler").
# DIRECT_URL is the direct host (no "-pooler") and is used only by Prisma migrations.
# Keep sslmode=require on both. pgbouncer=true marks the pooled URL for Prisma.
DATABASE_URL="postgresql://USER:PASSWORD@ep-EXAMPLE-pooler.REGION.aws.neon.tech/neondb?sslmode=require&pgbouncer=true"
DIRECT_URL="postgresql://USER:PASSWORD@ep-EXAMPLE.REGION.aws.neon.tech/neondb?sslmode=require"

# Local Postgres from `docker compose up -d` has no TLS, so use sslmode=disable
# and the same URL for both variables:
# DATABASE_URL="postgresql://ossu:ossu@127.0.0.1:5432/ossu?sslmode=disable"
# DIRECT_URL="postgresql://ossu:ossu@127.0.0.1:5432/ossu?sslmode=disable"
#
# A Postgres that already has TLS (including this project's verification setup)
# can use sslmode=require on localhost too:
# DATABASE_URL="postgresql://ossu:ossu@127.0.0.1:5432/ossu?sslmode=require"
# DIRECT_URL="postgresql://ossu:ossu@127.0.0.1:5432/ossu?sslmode=require"

# Required in production. Local dev falls back to a built-in secret if this is unset.
AUTH_SECRET="replace-with-a-long-random-string"

# Account passwords are read from the environment when you seed.
# On any database that is not localhost, the seed refuses to run without them.
LEARNER_EMAIL="momen@ossu.local"
LEARNER_PASSWORD="replace-learner-password"
LEARNER_NAME="Momen"

TUTOR_EMAIL="tutor@ossu.local"
TUTOR_PASSWORD="review-desk"
TUTOR_NAME="Tutor"
